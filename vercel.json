{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(?!index\\.html$|styles\\.css$|app\\.js$|favicon\\.svg$|og\\.png$|robots\\.txt$|assets/(?:nf-logo-mark-header\\.png|nathan-portrait-transparent\\.png)$).*",
      "dest": "/index.html"
    }
  ]
}
